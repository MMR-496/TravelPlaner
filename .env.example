# Esta lista dice qué variables usa la API. La API NO lee archivos .env:
# defínanlas con "set" en cmd, en la misma ventana donde corren uvicorn.
# NUNCA suban un .env real: ya está en .gitignore.

# Secreto para firmar los tokens JWT (una cadena larga y aleatoria). OBLIGATORIA:
# sin ella la API no arranca.
JWT_SECRETO=

# Gemini: la IA que sugiere actividades para un destino
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-lite-latest
# Para las pruebas con el simulador de fallas: http://127.0.0.1:9000
EXTERNO_URL=https://generativelanguage.googleapis.com

# Páginas que pueden usar la API desde el navegador (CORS), separadas por coma y SIN espacios
CORS_ORIGENES=http://127.0.0.1:5500,http://localhost:5500
